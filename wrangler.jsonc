{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "cleaning-boca-raton",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cleaning-boca-raton"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "BOOKING_OUTBOX",
			// Create with: pnpm exec wrangler kv namespace create BOOKING_OUTBOX
			// Then paste the id here (and preview_id from create --preview).
			"id": "a95a196475474eab91e3c0d93be15bd2",
			"preview_id": "REPLACE_WITH_BOOKING_OUTBOX_KV_PREVIEW_ID",
			"remote": true
		},
		{
			"binding": "BOOKING_OUTBOX_BOCA_RATON",
			"id": "7b488c5881274c33b42ac2114399805f",
			"remote": true
		}
	],
	"vars": {
		"BOOKING_BROOM_SITE_SLUG": "boca-raton",
		"BOOKING_BROOM_API_KEY": "bb_boca-raton_dev_key"
	}
}