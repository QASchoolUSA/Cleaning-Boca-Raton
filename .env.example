# Analytics Configuration
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here
NEXT_PUBLIC_CLARITY_PROJECT_ID=u380kr9hzd

# Production API URL (automatically set by NODE_ENV)
# NODE_ENV=production (set automatically by Vercel)

# Optional: your site URL
NEXT_PUBLIC_SITE_URL=https://cleaningbocaraton.com

# Booking Broom — forwards bookings to the manager dashboard
# Booking Broom sends customer + admin confirmation emails
# BOOKING_BROOM_URL optional; defaults to https://app.bookingbroom.com
# Optional local override (defaults to https://app.bookingbroom.com)
# BOOKING_BROOM_URL=http://localhost:3000
BOOKING_BROOM_API_KEY=bb_boca-raton_dev_key
BOOKING_BROOM_SITE_SLUG=boca-raton

# Fallback when Booking Broom is down (set as Cloudflare Worker secrets in prod):
# wrangler secret put TELEGRAM_BOT_TOKEN
# wrangler secret put TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
